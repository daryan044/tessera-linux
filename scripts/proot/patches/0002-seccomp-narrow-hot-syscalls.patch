+/* ioctl commands PRoot acts on: see the PR_ioctl cases in enter.c and
+ * exit.c.  Every other ioctl (GPU command submission, terminals, ...) goes
+ * straight to the kernel.  */
+static const uint32_t traced_ioctls[] = {
+	SIOCGIFINDEX,
+#ifdef __ANDROID__
+	TCSETS + 2 /* TCSAFLUSH */, TCGETS2, TCSETS2, TCSETSW2, TCSETSF2,
+#endif
+	_IOW(0x94, 9, int) /* FICLONE */,
+};
+#define NB_TRACED_IOCTLS (sizeof(traced_ioctls) / sizeof(traced_ioctls[0]))
+
+/**
+ * Number of statements add_trace_syscall() or add_narrow_trace_syscall()
+ * emits for @sysnum with @flags.
+ */
+static size_t trace_syscall_length(Sysnum sysnum, word_t flags)
+{
+	if (!(flags & FILTER_NARROW))
+		return LENGTH_TRACE_SYSCALL;
+	switch (sysnum) {
+	case PR_ioctl:
+		/* jne, ld, n * jeq, ret allow, ret trace */
+		return 4 + NB_TRACED_IOCTLS;
+	case PR_recvmsg:
+	case PR_sendmsg:
+		/* jne, ld, jge, ret allow, ret trace */
+		return 5;
+	default:
+		return LENGTH_TRACE_SYSCALL;
+	}
+}
+
+/**
+ * Like add_trace_syscall(), but notifies PRoot only for the argument
+ * values it acts on: ioctl() with one of @traced_ioctls, recvmsg() and
+ * sendmsg() on an emulated netlink socket (fd >= NETLINK_FD_BASE).  Each
+ * of these goes through PRoot thousands of times a second for a browser
+ * or a GPU driver, and the tracer is a single thread every tracee waits
+ * on.
+ */
+static int add_narrow_trace_syscall(struct sock_fprog *program, Sysnum sysnum,
+				word_t syscall, int flag)
+{
+	const size_t arg_offset = sysnum == PR_ioctl
+		? offsetof(struct seccomp_data, args[1])
+		: offsetof(struct seccomp_data, args[0]);
+	const size_t length = trace_syscall_length(sysnum, FILTER_NARROW);
+	struct sock_filter statements[4 + NB_TRACED_IOCTLS + 1];
+	size_t n = 0, i;
+
+	if (syscall > UINT32_MAX || length > sizeof(statements) / sizeof(statements[0]))
+		return -ERANGE;
+
+	/* Not this syscall: skip the whole block, the accumulator still
+	 * holds the syscall number.  */
+	statements[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, length - 1);
+
+	/* The low 32 bits of the argument (little endian).  */
+	statements[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, arg_offset);
+
+	if (sysnum == PR_ioctl) {
+		for (i = 0; i < NB_TRACED_IOCTLS; i++) {
+			/* Jump to "ret trace", the last statement.  */
+			size_t to_trace = length - 1 - (n + 1);
+			statements[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K,
+									traced_ioctls[i], to_trace, 0);
+		}
+	}
+	else
+		statements[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JGE + BPF_K,
+								NETLINK_FD_BASE, 1, 0);
+
+	/* The accumulator was overwritten: decide here, for good.  */
+	statements[n++] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW);
+	statements[n++] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag);
+
+	if (n != length)
+		return -ERANGE;
+
+	DEBUG_FILTER("FILTER:     trace if syscall == %ld, narrowed\n", syscall);
+
+	return add_statements(program, length, statements);
+}
