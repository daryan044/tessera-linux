 /**
+ * Moves the netlink socket @fd that PRoot emulates (see enter.c) to the
+ * lowest free fd from NETLINK_FD_BASE on, where the seccomp filter
+ * traces recvmsg/sendmsg (see seccomp.c): dup3() and close() are
+ * chained, and socket() returns the new fd.  Returns the fd the tracee
+ * will have, or @fd as it was when it can't be moved.
+ */
+static int relocate_netlink_fd(Tracee *tracee, int fd)
+{
+	char path[64];
+	struct stat st;
+	struct rlimit limit;
+	int target;
+
+	if (fd < 0 || fd >= NETLINK_FD_BASE)
+		return fd;
+
+	/* The tracee's fd table, as the tracer sees it.  */
+	for (target = NETLINK_FD_BASE; target < NETLINK_FD_BASE + 256; target++) {
+		snprintf(path, sizeof(path), "/proc/%d/fd/%d", tracee->pid, target);
+		if (lstat(path, &st) < 0 && errno == ENOENT)
+			break;
+	}
+	if (target == NETLINK_FD_BASE + 256)
+		return fd;
+
+	/* dup3() fails beyond the tracee's limit; keep the fd then.  */
+	if (prlimit(tracee->pid, RLIMIT_NOFILE, NULL, &limit) == 0
+	    && limit.rlim_cur != RLIM_INFINITY && (rlim_t) target >= limit.rlim_cur)
+		return fd;
+
+	if (register_chained_syscall(tracee, PR_dup3, fd, target,
+			(peek_reg(tracee, ORIGINAL, SYSARG_2) & SOCK_CLOEXEC) ? O_CLOEXEC : 0, 0, 0, 0) < 0
+	    || register_chained_syscall(tracee, PR_close, fd, 0, 0, 0, 0, 0) < 0)
+		return fd;
+
+	force_chain_final_result(tracee, target);
+	return target;
+}
