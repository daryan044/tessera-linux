+/* Tessera: shares a memfd with the server for the frames of chain (MIT-SHM 1.2, which takes
+ * a file descriptor: Android has no System V shared memory). Returns whether it's usable.
+ */
+static bool
+x11_sw_shm_init(struct x11_swapchain *chain, size_t size)
+{
+   if (chain->sw_shm_state)
+      return chain->sw_shm_state > 0;
+   chain->sw_shm_state = -1;
+
+   xcb_shm_query_version_reply_t *ver =
+      xcb_shm_query_version_reply(chain->conn, xcb_shm_query_version(chain->conn), NULL);
+   bool fd_passing = ver && (ver->major_version > 1 ||
+                             (ver->major_version == 1 && ver->minor_version >= 2));
+   free(ver);
+   if (!fd_passing)
+      return false;
+
+   int fd = memfd_create("mesa-wsi-sw", MFD_CLOEXEC);
+   if (fd < 0)
+      return false;
+   if (ftruncate(fd, size) < 0) {
+      close(fd);
+      return false;
+   }
+   uint8_t *map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (map == MAP_FAILED) {
+      close(fd);
+      return false;
+   }
+
+   xcb_shm_seg_t seg = xcb_generate_id(chain->conn);
+   /* xcb sends the fd and closes it. */
+   xcb_generic_error_t *err =
+      xcb_request_check(chain->conn, xcb_shm_attach_fd_checked(chain->conn, seg, fd, true));
+   if (err) {
+      free(err);
+      munmap(map, size);
+      return false;
+   }
+
+   chain->sw_shmseg = seg;
+   chain->sw_shm_map = map;
+   chain->sw_shm_size = size;
+   chain->sw_shm_state = 1;
+   return true;
+}
