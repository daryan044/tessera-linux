+/* Tessera: puts rows [y, y + height) of a software frame into dst, full width, in as few
+ * requests as the server's size limit allows.
+ */
+static void
+x11_put_rows_sw(struct x11_swapchain *chain, xcb_drawable_t dst, const uint8_t *data,
+                int stride_b, int y, int height, uint64_t max_req_len)
+{
+   size_t hdr_len = sizeof(xcb_put_image_request_t);
+   int num_lines = MAX2(1, (int)(((max_req_len << 2) - hdr_len) / stride_b));
+   while (height > 0) {
+      int this_lines = MIN2(num_lines, height);
+      xcb_void_cookie_t cookie =
+         xcb_put_image(chain->conn, XCB_IMAGE_FORMAT_Z_PIXMAP, dst, chain->gc,
+                       stride_b / 4, this_lines, 0, y, 0, chain->depth,
+                       this_lines * stride_b, data + (size_t)y * stride_b);
+      xcb_discard_reply(chain->conn, cookie.sequence);
+      y += this_lines;
+      height -= this_lines;
+   }
+}
