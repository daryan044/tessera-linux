<?xml version="1.0" encoding="utf-8"?>
<!-- A progress ring for widgets, which can only draw progress through a ProgressBar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:innerRadiusRatio="2.7" android:shape="ring" android:thicknessRatio="9" android:useLevel="false">
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:pivotX="50%" android:pivotY="50%" android:toDegrees="270">
            <shape android:innerRadiusRatio="2.7" android:shape="ring" android:thicknessRatio="9" android:useLevel="true">
                <solid android:color="@color/widget_accent" />
            </shape>
        </rotate>
    </item>
</layer-list>
